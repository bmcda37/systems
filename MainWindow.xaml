<Window x:Class="GpoScapAnalyzer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GPO / SCAP Analyzer"
        Height="800"
        Width="1400"
        MinHeight="600"
        MinWidth="1000"
        Background="#F5F7FA">

    <Grid>

        <!-- Main Layout -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="190"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>


        <!-- ========================= -->
        <!-- LEFT NAVIGATION             -->
        <!-- ========================= -->

        <Border Grid.Column="0"
                Background="#17324D">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>


                <!-- Application Name -->

                <StackPanel Grid.Row="0"
                            Margin="20,25,20,30">

                    <TextBlock Text="GPO /"
                               Foreground="White"
                               FontSize="22"
                               FontWeight="Bold"/>

                    <TextBlock Text="SCAP Analyzer"
                               Foreground="White"
                               FontSize="22"
                               FontWeight="Bold"/>

                </StackPanel>


                <!-- Navigation -->

                <StackPanel Grid.Row="1">

                    <Button Content="⌂   Home"
                            Height="50"
                            Background="#2468A8"
                            Foreground="White"
                            BorderThickness="0"
                            HorizontalContentAlignment="Left"
                            Padding="20,0"
                            FontSize="15"/>

                    <Button Content="▣   GPO Analysis"
                            Height="50"
                            Background="Transparent"
                            Foreground="White"
                            BorderThickness="0"
                            HorizontalContentAlignment="Left"
                            Padding="20,0"
                            FontSize="15"/>

                    <Button Content="▤   SCAP Benchmark"
                            Height="50"
                            Background="Transparent"
                            Foreground="White"
                            BorderThickness="0"
                            HorizontalContentAlignment="Left"
                            Padding="20,0"
                            FontSize="15"/>

                    <Button Content="◈   Tenable Results"
                            Height="50"
                            Background="Transparent"
                            Foreground="White"
                            BorderThickness="0"
                            HorizontalContentAlignment="Left"
                            Padding="20,0"
                            FontSize="15"/>

                    <Button Content="⇄   Comparison"
                            Height="50"
                            Background="Transparent"
                            Foreground="White"
                            BorderThickness="0"
                            HorizontalContentAlignment="Left"
                            Padding="20,0"
                            FontSize="15"/>

                    <Button Content="▧   Reports"
                            Height="50"
                            Background="Transparent"
                            Foreground="White"
                            BorderThickness="0"
                            HorizontalContentAlignment="Left"
                            Padding="20,0"
                            FontSize="15"/>

                </StackPanel>


                <!-- Settings -->

                <Button Grid.Row="2"
                        Content="⚙   Settings"
                        Height="50"
                        Margin="0,0,0,20"
                        Background="Transparent"
                        Foreground="White"
                        BorderThickness="0"
                        HorizontalContentAlignment="Left"
                        Padding="20,0"
                        FontSize="15"/>

            </Grid>

        </Border>


        <!-- ========================= -->
        <!-- MAIN CONTENT                -->
        <!-- ========================= -->

        <Grid Grid.Column="1"
              Margin="25">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>


            <!-- Header -->

            <StackPanel Grid.Row="0"
                        Margin="0,0,0,20">

                <TextBlock Text="GPO / SCAP Analyzer"
                           FontSize="30"
                           FontWeight="Bold"
                           Foreground="#172B4D"/>

                <TextBlock Text="Analyze, compare, and report on your GPO, SCAP, and Tenable data."
                           FontSize="14"
                           Foreground="#64748B"
                           Margin="0,5,0,0"/>

            </StackPanel>


            <!-- ========================= -->
            <!-- INPUT SECTION              -->
            <!-- ========================= -->

            <Border Grid.Row="1"
                    Background="White"
                    CornerRadius="8"
                    Padding="15"
                    Margin="0,0,0,20"
                    BorderBrush="#D9E0E7"
                    BorderThickness="1">

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="1.5*"/>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>


                    <!-- GPO -->

                    <StackPanel Grid.Column="0"
                                Margin="0,0,15,0">

                        <TextBlock Text="GPO Backup Folder"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,6"/>

                        <DockPanel>

                            <Button Content="Browse..."
                                    DockPanel.Dock="Right"
                                    Width="90"
                                    Margin="5,0,0,0"/>

                            <TextBox Text="C:\GPOBackups\Domain Security Policy"
                                     Height="32"
                                     Padding="8"/>

                        </DockPanel>

                    </StackPanel>


                    <!-- SCAP -->

                    <StackPanel Grid.Column="1"
                                Margin="0,0,15,0">

                        <TextBlock Text="SCAP Benchmark"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,6"/>

                        <ComboBox Height="32"
                                  Padding="5">

                            <ComboBoxItem Content="DISA Windows 11 STIG"
                                          IsSelected="True"/>

                            <ComboBoxItem Content="DISA Windows 10 STIG"/>

                            <ComboBoxItem Content="Custom SCAP Benchmark"/>

                        </ComboBox>

                    </StackPanel>


                    <!-- Tenable -->

                    <StackPanel Grid.Column="2"
                                Margin="0,0,15,0">

                        <TextBlock Text="Tenable Results (Optional)"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,6"/>

                        <DockPanel>

                            <Button Content="Browse..."
                                    DockPanel.Dock="Right"
                                    Width="90"
                                    Margin="5,0,0,0"/>

                            <TextBox Text="C:\Tenable\results.xml"
                                     Height="32"
                                     Padding="8"/>

                        </DockPanel>

                    </StackPanel>


                    <!-- Analyze Button -->

                    <Button Grid.Column="3"
                            Content="▶  Run Analysis"
                            Width="140"
                            Height="40"
                            VerticalAlignment="Bottom"
                            Background="#1261A0"
                            Foreground="White"
                            BorderThickness="0"
                            FontWeight="Bold"/>

                </Grid>

            </Border>


            <!-- ========================= -->
            <!-- ANALYSIS AREA              -->
            <!-- ========================= -->

            <Grid Grid.Row="2">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="270"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="270"/>
                </Grid.ColumnDefinitions>


                <!-- ========================= -->
                <!-- GPO TREE                   -->
                <!-- ========================= -->

                <Border Grid.Column="0"
                        Background="White"
                        CornerRadius="8"
                        BorderBrush="#D9E0E7"
                        BorderThickness="1"
                        Margin="0,0,10,0"
                        Padding="10">

                    <Grid>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>


                        <TextBox Grid.Row="0"
                                 Text="Search settings..."
                                 Height="32"
                                 Padding="8"
                                 Margin="0,0,0,10"/>


                        <TreeView Grid.Row="1">

                            <TreeViewItem Header="📁 Computer Configuration"
                                          IsExpanded="True">

                                <TreeViewItem Header="📁 Policies"
                                              IsExpanded="True">

                                    <TreeViewItem Header="📁 Windows Settings"
                                                  IsExpanded="True">

                                        <TreeViewItem Header="📁 Security Settings"
                                                      IsExpanded="True">

                                            <TreeViewItem Header="📁 Account Policies"
                                                          IsExpanded="True">

                                                <TreeViewItem Header="🔐 Password Policy"
                                                              IsSelected="True"/>

                                                <TreeViewItem Header="🔐 Account Lockout Policy"/>

                                                <TreeViewItem Header="🔐 Kerberos Policy"/>

                                            </TreeViewItem>

                                            <TreeViewItem Header="📁 Local Policies"/>

                                            <TreeViewItem Header="📁 Event Log"/>

                                            <TreeViewItem Header="📁 Restricted Groups"/>

                                            <TreeViewItem Header="📁 System Services"/>

                                            <TreeViewItem Header="📁 Registry"/>

                                            <TreeViewItem Header="📁 File System"/>

                                            <TreeViewItem Header="📁 Windows Defender Firewall"/>

                                        </TreeViewItem>

                                    </TreeViewItem>

                                    <TreeViewItem Header="📁 Administrative Templates"/>

                                    <TreeViewItem Header="📁 Preferences"/>

                                </TreeViewItem>

                            </TreeViewItem>


                            <TreeViewItem Header="📁 User Configuration"
                                          IsExpanded="True">

                                <TreeViewItem Header="📁 Policies">

                                    <TreeViewItem Header="📁 Administrative Templates"/>

                                </TreeViewItem>

                            </TreeViewItem>

                        </TreeView>

                    </Grid>

                </Border>


                <!-- ========================= -->
                <!-- CENTER DETAILS              -->
                <!-- ========================= -->

                <Border Grid.Column="1"
                        Background="White"
                        CornerRadius="8"
                        BorderBrush="#D9E0E7"
                        BorderThickness="1"
                        Margin="0,0,10,0"
                        Padding="15">

                    <Grid>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>


                        <!-- Breadcrumb -->

                        <TextBlock Grid.Row="0"
                                   Text="Computer Configuration  >  Policies  >  Windows Settings  >  Security Settings  >  Account Policies  >  Password Policy"
                                   Foreground="#64748B"
                                   FontSize="12"
                                   Margin="0,0,0,10"/>


                        <TextBlock Grid.Row="1"
                                   Text="Password Policy"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="#172B4D"
                                   Margin="0,0,0,15"/>


                        <!-- Settings -->

                        <DataGrid Grid.Row="2"
                            AutoGenerateColumns="False"
                            CanUserAddRows="False"
                            HeadersVisibility="Column"
                            IsReadOnly="True">

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Setting"
                                                    Binding="{Binding Setting}"
                                                    Width="*"/>

                                <DataGridTextColumn Header="Value"
                                                    Binding="{Binding Value}"
                                                    Width="100"/>

                                <DataGridTextColumn Header="Type"
                                                    Binding="{Binding Type}"
                                                    Width="120"/>

                                <DataGridTextColumn Header="Source"
                                                    Binding="{Binding Source}"
                                                    Width="80"/>
                            </DataGrid.Columns>

                        </DataGrid>

                        <!-- Details -->

                        <Border Grid.Row="3"
                                Background="#F8FAFC"
                                BorderBrush="#E2E8F0"
                                BorderThickness="1"
                                Padding="15"
                                Margin="0,15,0,0">

                            <StackPanel>

                                <TextBlock Text="Setting Details"
                                           FontWeight="Bold"
                                           FontSize="16"
                                           Margin="0,0,0,10"/>

                                <Grid>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="Name:"
                                               FontWeight="SemiBold"/>

                                    <TextBlock Grid.Column="1"
                                               Text="Minimum password length"/>

                                </Grid>

                                <Grid Margin="0,8,0,0">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="Registry Path:"
                                               FontWeight="SemiBold"/>

                                    <TextBlock Grid.Column="1"
                                               Text="HKLM\Software\Microsoft\Windows\CurrentVersion\Policies\System"/>

                                </Grid>

                                <Grid Margin="0,8,0,0">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="Value:"
                                               FontWeight="SemiBold"/>

                                    <TextBlock Grid.Column="1"
                                               Text="14"/>

                                </Grid>

                            </StackPanel>

                        </Border>

                    </Grid>

                </Border>


                <!-- ========================= -->
                <!-- RIGHT PANEL                 -->
                <!-- ========================= -->

                <StackPanel Grid.Column="2">


                    <!-- Summary -->

                    <Border Background="White"
                            CornerRadius="8"
                            BorderBrush="#D9E0E7"
                            BorderThickness="1"
                            Padding="15"
                            Margin="0,0,0,10">

                        <StackPanel>

                            <TextBlock Text="Analysis Summary"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Margin="0,0,0,15"/>

                            <TextBlock Text="Total STIG Rules"
                                       FontWeight="SemiBold"/>

                            <TextBlock Text="312"
                                       FontSize="26"
                                       FontWeight="Bold"
                                       Margin="0,2,0,12"/>

                            <TextBlock Text="✓  Passed       271"
                                       Foreground="#16A34A"
                                       FontSize="15"
                                       Margin="0,4"/>

                            <TextBlock Text="✕  Failed          25"
                                       Foreground="#DC2626"
                                       FontSize="15"
                                       Margin="0,4"/>

                            <TextBlock Text="!  Drift             16"
                                       Foreground="#EA8A00"
                                       FontSize="15"
                                       Margin="0,4"/>

                        </StackPanel>

                    </Border>


                    <!-- Selected Items -->

                    <Border Background="White"
                            CornerRadius="8"
                            BorderBrush="#D9E0E7"
                            BorderThickness="1"
                            Padding="15"
                            Margin="0,0,0,10">

                        <StackPanel>

                            <TextBlock Text="Selected Items"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Margin="0,0,0,15"/>

                            <TextBlock Text="GPO Backup"
                                       FontWeight="SemiBold"/>

                            <TextBlock Text="Domain Security Policy"
                                       Foreground="#475569"
                                       Margin="0,3,0,12"/>

                            <TextBlock Text="SCAP Benchmark"
                                       FontWeight="SemiBold"/>

                            <TextBlock Text="Windows 11 STIG"
                                       Foreground="#475569"
                                       Margin="0,3,0,12"/>

                            <TextBlock Text="Tenable Results"
                                       FontWeight="SemiBold"/>

                            <TextBlock Text="Not loaded"
                                       Foreground="#475569"/>

                        </StackPanel>

                    </Border>


                    <!-- Quick Actions -->

                    <Border Background="White"
                            CornerRadius="8"
                            BorderBrush="#D9E0E7"
                            BorderThickness="1"
                            Padding="15">

                        <StackPanel>

                            <TextBlock Text="Quick Actions"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Margin="0,0,0,15"/>

                            <Button Content="▶  Run LGPO (Parse GPO)"
                                    Height="42"
                                    Margin="0,0,0,10"/>

                            <Button Content="▧  View Full Report"
                                    Height="42"
                                    Margin="0,0,0,10"/>

                            <Button Content="↻  Refresh Data"
                                    Height="42"/>

                        </StackPanel>

                    </Border>

                </StackPanel>

            </Grid>

        </Grid>

    </Grid>

</Window>
